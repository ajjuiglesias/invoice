# Leave both blank (or delete this file) to run the app exactly as Phase A:
# everything in the browser, no accounts, nothing uploaded.
#
# Fill both in to turn on team mode — logins, shared invoice history, manager
# approval and the admin rate card. Copy this file to .env.local first.
#
# Both values come from your Supabase project: Settings -> API.
# The anon key is designed to be public; row level security is what protects
# the data, not the secrecy of this key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
